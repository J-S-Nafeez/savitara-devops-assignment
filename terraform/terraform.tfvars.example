# ==============================================================================
# Terraform Variables Example Configuration
# Copy this file to terraform.tfvars and customize with your parameters
# ==============================================================================

aws_region   = "ap-south-1"
project_name = "savitara"
environment  = "prod"

# Networking
vpc_cidr                 = "10.0.0.0/16"
availability_zones       = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs      = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
private_db_subnet_cidrs  = ["10.0.21.0/24", "10.0.22.0/24"]

# EC2 & Auto Scaling Group
app_port             = 3000
instance_type        = "t3.micro"
asg_min_size         = 2
asg_max_size         = 5
asg_desired_capacity = 2

# RDS MySQL
db_name              = "savitara_db"
db_username          = "dbadmin"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
rds_multi_az         = false

# Application Load Balancer & SSL
enable_https    = true
certificate_arn = "" # Set to your existing ACM Certificate ARN if available

# Tags
tags = {
  Owner       = "DevOps Candidate"
  Assessment  = "Savitara Infotel DevOps Assignment"
  ManagedBy   = "Terraform"
}

